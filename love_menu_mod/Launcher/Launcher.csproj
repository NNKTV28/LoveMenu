<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LoveMenuLauncher</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <Version>1.3.2</Version>
  </PropertyGroup>

  <!-- The launcher installs the plugin itself, so the plugin DLL is
       embedded. Build ../FlyMod.csproj (Release) first. -->
  <PropertyGroup>
    <PluginDll>..\bin\Release\FlyMod.dll</PluginDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- Folder picker when the game can't be found automatically. -->
    <Reference Include="System.Windows.Forms" />
    <EmbeddedResource Include="$(PluginDll)" LogicalName="FlyMod.dll" />
    <!-- Official BepInEx 5 x64 release zip (MIT, see ThirdParty/BepInEx-LICENSE.txt),
         installed automatically when the game folder doesn't have it yet. -->
    <EmbeddedResource Include="ThirdParty\BepInEx_win_x64_5.4.23.5.zip" LogicalName="BepInEx.zip" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <Target Name="RequirePluginDll" BeforeTargets="BeforeBuild" Condition="!Exists('$(PluginDll)')">
    <Error Text="$(PluginDll) not found. Build ../FlyMod.csproj -c Release first." />
  </Target>

</Project>
