<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LoveMenuLauncher</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <Version>1.8.0</Version>
    <!-- Shown in the exe's Properties > Details. -->
    <Product>Love Menu</Product>
    <AssemblyTitle>Love Menu Launcher</AssemblyTitle>
    <Description>Installs and starts the Love Menu mod menu for Lovecraft.</Description>
    <Company>NNKtv28</Company>
    <Authors>NNKtv28</Authors>
    <Copyright>Copyright © 2026 NNKtv28 - MIT License</Copyright>
  </PropertyGroup>

  <!-- Code signing, once a code-signing certificate is installed: set
       LOVEMENU_SIGN_THUMBPRINT to its thumbprint and every Release build is
       signed and timestamped. Without it, nothing changes. -->
  <Target Name="SignLauncher" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(LOVEMENU_SIGN_THUMBPRINT)' != ''">
    <Exec Command="signtool sign /sha1 $(LOVEMENU_SIGN_THUMBPRINT) /fd SHA256 /tr http://timestamp.digicert.com /td SHA256 /d &quot;Love Menu&quot; &quot;$(TargetPath)&quot;" />
  </Target>

  <!-- The launcher installs the plugin itself, so the plugin DLL is
       embedded. Build ../FlyMod.csproj (Release) first. -->
  <PropertyGroup>
    <PluginDll>..\bin\Release\FlyMod.dll</PluginDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- Folder picker when the game can't be found automatically. -->
    <Reference Include="System.Windows.Forms" />
    <EmbeddedResource Include="$(PluginDll)" LogicalName="FlyMod.dll" />
    <!-- Official BepInEx 5 x64 release zip (MIT, see ThirdParty/BepInEx-LICENSE.txt),
         installed automatically when the game folder doesn't have it yet. -->
    <EmbeddedResource Include="ThirdParty\BepInEx_win_x64_5.4.23.5.zip" LogicalName="BepInEx.zip" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <Target Name="RequirePluginDll" BeforeTargets="BeforeBuild" Condition="!Exists('$(PluginDll)')">
    <Error Text="$(PluginDll) not found. Build ../FlyMod.csproj -c Release first." />
  </Target>

</Project>
